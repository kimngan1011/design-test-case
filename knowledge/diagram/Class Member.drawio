        </mxCell>
        <mxCell id="footer" parent="1" style="text;html=1;fontSize=11;fontColor=#888888;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" value="Source: erp-salesforce — ClassMemberMasterQueueExecutor.cls, LessonClassMemberHandler.cls, LessonScheduleHandler.cls, LessonScheduleClassHandler.cls, LessonAllocationLocationCourseHandler.cls, LessonAllocationHandler.cls, ManualSessionCleanupMasterQueueExecutor.cls, StudentSessionsHandler.cls, LessonFeatureToggles.cls. Full detail: knowledge/domain-knowledge/scheduling/lesson-management/class-assignment.md" vertex="1">
          <mxGeometry height="36" width="1200" x="40" y="2420" as="geometry" />
        </mxCell>
        <mxCell id="R5A" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E4EFEE;strokeColor=#1B6E72;strokeWidth=2;align=left;valign=middle;spacingLeft=8;fontSize=11;" value="&lt;b&gt;MQ: Yes&lt;/b&gt; — same ClassMemberMasterQueueExecutor job as always (unchanged by this PR).&lt;br&gt;Removed unconditionally if Lesson.Start_Date_Time__c &gt; new End_Date_Time__c — the FIRST check inside removeSessionsByClass, before any class-match/duration check." vertex="1">
          <mxGeometry height="220" width="430" x="320" y="1130" as="geometry" />
        </mxCell>
        <mxCell id="R5M" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5EAD6;strokeColor=#A6721A;strokeWidth=2;align=left;valign=middle;spacingLeft=8;fontSize=11;" value="&lt;b&gt;Toggle OFF (default): MQ: No&lt;/b&gt;, nothing enqueued — known gap.&lt;br&gt;&lt;b&gt;Toggle ON: MQ: Yes&lt;/b&gt; — but a SEPARATE job, ManualSessionCleanupMasterQueueExecutor (independent, not chained to the class-member job). Removes if Lesson.Start &gt; new End_Date, lesson not Completed.&lt;br&gt;⚠️ Applies to ANY LA — Student_Product_ID__c check was removed mid-PR; not SPO-scoped despite the field&#39;s name." vertex="1">
          <mxGeometry height="220" width="430" x="750" y="1130" as="geometry" />
        </mxCell>
        <mxCell id="R6T" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#888888;fontStyle=1;align=left;valign=middle;spacingLeft=8;" value="Remove Class from Lesson Schedule&lt;br&gt;&lt;span style=&quot;font-size:10.5px;font-weight:normal;color:#666&quot;&gt;LSC delete&lt;/span&gt;" vertex="1">
          <mxGeometry height="100" width="280" x="40" y="1370" as="geometry" />
        </mxCell>
        <mxCell id="R6A" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E4EFEE;strokeColor=#1B6E72;align=left;valign=middle;spacingLeft=8;fontSize=11;" value="&lt;b&gt;MQ: No&lt;/b&gt; — synchronous, runs inline in the LWC transaction (removeAutoAssignedSessionsByRemovedLessonScheduleClasses), NOT via Master Queue.&lt;br&gt;Removed if not covered by a remaining class on the same schedule." vertex="1">
          <mxGeometry height="100" width="430" x="320" y="1370" as="geometry" />
        </mxCell>
        <mxCell id="R6M" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F0E3;strokeColor=#4C7A3D;align=left;valign=middle;spacingLeft=8;fontSize=11;" value="&lt;b&gt;MQ: N/A&lt;/b&gt; — never touched. Query filters Assignment_Source__c = Auto (verified in query). Manual is out of scope by design, not a gap." vertex="1">
          <mxGeometry height="100" width="430" x="750" y="1370" as="geometry" />
        </mxCell>
        <mxCell id="R7T" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#888888;fontStyle=1;align=left;valign=middle;spacingLeft=8;" value="Change Location Course&lt;br&gt;&lt;span style=&quot;font-size:10.5px;font-weight:normal;color:#666&quot;&gt;+ new class picked&lt;/span&gt;" vertex="1">
          <mxGeometry height="90" width="280" x="40" y="1470" as="geometry" />
        </mxCell>
        <mxCell id="R7A" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E4EFEE;strokeColor=#1B6E72;align=left;valign=middle;spacingLeft=8;fontSize=11;" value="&lt;b&gt;MQ: Yes&lt;/b&gt; — ClassMemberMasterQueueExecutor, triggered via new Class_Member insert → AFTER_INSERT re-scan.&lt;br&gt;New Auto session created under the new class." vertex="1">
          <mxGeometry height="90" width="430" x="320" y="1470" as="geometry" />
        </mxCell>
        <mxCell id="R7M" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F0;strokeColor=#888888;align=left;valign=middle;spacingLeft=8;fontSize=11;" value="&lt;b&gt;MQ: N/A&lt;/b&gt; for new assignment. Old Manual sessions under the previous class are also left untouched." vertex="1">
          <mxGeometry height="90" width="430" x="750" y="1470" as="geometry" />
        </mxCell>
        <mxCell id="R8T" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#888888;fontStyle=1;align=left;valign=middle;spacingLeft=8;" value="Change Location Course&lt;br&gt;&lt;span style=&quot;font-size:10.5px;font-weight:normal;color:#666&quot;&gt;NO new class picked&lt;/span&gt;" vertex="1">
          <mxGeometry height="90" width="280" x="40" y="1560" as="geometry" />
        </mxCell>
        <mxCell id="R8A" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F0E3;strokeColor=#4C7A3D;align=left;valign=middle;spacingLeft=8;fontSize=11;" value="&lt;b&gt;MQ: No&lt;/b&gt; — nothing enqueued at all. LA&#39;s Location_Course updates only; engine never checks Location_Course__c. Correct by design (toggle OFF, the coded default)." vertex="1">
          <mxGeometry height="90" width="430" x="320" y="1560" as="geometry" />
        </mxCell>
        <mxCell id="R8M" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F0E3;strokeColor=#4C7A3D;align=left;valign=middle;spacingLeft=8;fontSize=11;" value="&lt;b&gt;MQ: No&lt;/b&gt; — same, untouched, correct by design. (Toggle-ON case is opt-in, not confirmed live on any org.)" vertex="1">
          <mxGeometry height="90" width="430" x="750" y="1560" as="geometry" />
